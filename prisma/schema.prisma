generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS — Explicit Domain Statuses, Commercial Models & Policy Controls
// ============================================================================

enum PortalType {
  CONSULTANCY
  PARTNER
}

enum RoleScope {
  CONSULTANCY
  PARTNER
}

enum PartnerRoleCode {
  PARTNER_ADMIN
  PARTNER_STAFF
  PARTNER_REPORT_MANAGER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ConsentType {
  DATA_PROCESSING
  WHATSAPP_COMMUNICATION
  EMAIL_COMMUNICATION
  PARTNER_SHARING
}

enum PartnerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CommercialModel {
  MODEL_A_CONSULTANCY_COLLECTS
  MODEL_B_PATIENT_PAYS_PARTNER
}

enum AllowedContractModels {
  MODEL_A_ONLY
  MODEL_B_ONLY
  BOTH
}

enum CommissionCalculationBasis {
  UNCONFIGURED
  NET_AFTER_DISCOUNT_EXCL_TAX
  GROSS_BEFORE_DISCOUNT_EXCL_TAX
  NET_INCL_TAX
}

enum PartnerPhoneVisibility {
  MASKED
  FULL
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum SettlementCycle {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  MANUAL
}

enum DocumentSequenceType {
  PATIENT
  ORDER
  INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
  RECEIPT
  REFUND
  SETTLEMENT
  JOURNAL
}

enum SupplyCategory {
  DIAGNOSTIC_SERVICE
  CONSULTANCY_COMMISSION
  OTHER_FEE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  PARTIALLY_COMPLETED
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  UNABLE_TO_PERFORM
}

enum SettlementLockStatus {
  UNSETTLED
  IN_SETTLEMENT
  SETTLED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  VOID
}

enum AdjustmentNoteType {
  CREDIT_NOTE
  DEBIT_NOTE
}

enum DocumentKind {
  ISSUED_INVOICE_PDF
  ACCOUNT_STATEMENT_PDF
  RECEIPT_PDF
  CREDIT_NOTE_PDF
  DEBIT_NOTE_PDF
  SETTLEMENT_PDF
}

enum ShareResourceType {
  INVOICE
  RECEIPT
  STATEMENT
  REPORT
}

enum ShareChannel {
  WHATSAPP
  EMAIL
  LINK_COPY
  DOWNLOAD
  PRINT
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  MANUAL
  PROVIDER_NOT_CONFIGURED
}

enum PaymentMethod {
  CASH
  UPI_QR
  UPI_ONLINE
  CARD
  NETBANKING
  BANK_TRANSFER
  WALLET
  STATIC_QR_MANUAL
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum GatewayProvider {
  RAZORPAY
}

enum GatewaySettlementState {
  UNSETTLED
  SETTLED_BY_GATEWAY
  BANK_RECONCILED
}

enum QrMode {
  DYNAMIC_SINGLE_USE
  STATIC_FALLBACK
}

enum QrSessionStatus {
  ACTIVE
  CREDITED
  EXPIRED
  CLOSED
  CANCELLED
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED_DUPLICATE
  FAILED
}

enum RefundMethod {
  GATEWAY_REVERSAL
  CASH
  BANK_TRANSFER
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
  CANCELLED
}

enum CollectionRecordType {
  MODEL_B_PARTNER_DIRECT
  STATIC_QR_UNMATCHED
}

enum ReconciliationStatus {
  UNRECONCILED
  MATCHED
  DISPUTED
}

enum ReportTrackingStatus {
  AWAITING
  PROCESSING
  UPLOADED
  REVIEWED
  READY
  DELIVERED
}

enum SettlementDirection {
  PAYABLE_TO_PARTNER
  RECEIVABLE_FROM_PARTNER
}

enum SettlementStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_SETTLED
  SETTLED
  CANCELLED
  REVERSED
}

enum PartnerPaymentDirection {
  OUTFLOW_TO_PARTNER
  INFLOW_FROM_PARTNER
}

enum PartnerPayoutMethod {
  NEFT
  RTGS
  IMPS
  UPI
  CHEQUE
  CASH
}

enum PartnerAdjustmentType {
  CREDIT
  DEBIT
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

// ============================================================================
// 1. ORGANIZATION, SETTINGS, SEQUENCES & TAX CONFIGURATION
// ============================================================================

model Organization {
  id                  String   @id @default(uuid()) @db.Uuid
  code                String   @unique @db.VarChar(32)
  legalName           String   @map("legal_name") @db.VarChar(200)
  displayName         String   @map("display_name") @db.VarChar(200)
  gstin               String?  @db.VarChar(20)
  pan                 String?  @db.VarChar(16)
  cin                 String?  @db.VarChar(30)
  registeredAddress   String   @map("registered_address") @db.Text
  city                String   @db.VarChar(100)
  stateCode           String   @map("state_code") @db.Char(2)
  stateName           String   @map("state_name") @db.VarChar(100)
  pincode             String   @db.VarChar(12)
  contactEmail        String   @map("contact_email") @db.VarChar(160)
  contactPhone        String   @map("contact_phone") @db.VarChar(24)
  website             String?  @db.VarChar(200)
  logoStorageKey      String?  @map("logo_storage_key") @db.VarChar(255)
  signatureStorageKey String?  @map("signature_storage_key") @db.VarChar(255)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  settings  OrganizationSettings?
  sequences InvoiceSequence[]

  @@map("organizations")
}

model OrganizationSettings {
  id                                   String                     @id @default(uuid()) @db.Uuid
  organizationId                       String                     @unique @map("organization_id") @db.Uuid
  defaultCommissionBasis               CommissionCalculationBasis @default(UNCONFIGURED) @map("default_commission_basis")
  requireConsultancyCompletionApproval Boolean                    @default(false) @map("require_consultancy_completion_approval")
  allowInvoiceOverpayment              Boolean                    @default(false) @map("allow_invoice_overpayment")
  partnerPatientPhoneVisibility        PartnerPhoneVisibility     @default(MASKED) @map("partner_patient_phone_visibility")
  requireSettlementApproval            Boolean                    @default(true) @map("require_settlement_approval")
  gstEnabled                           Boolean                    @default(false) @map("gst_enabled")
  invoiceDocumentTitle                 String                     @default("Invoice") @map("invoice_document_title") @db.VarChar(80)
  staticQrFallbackEnabled              Boolean                    @default(false) @map("static_qr_fallback_enabled")
  staticQrVpaLabel                     String?                    @map("static_qr_vpa_label") @db.VarChar(120)
  shareLinkDefaultTtlHours             Int                        @default(72) @map("share_link_default_ttl_hours")
  invoiceTermsText                     String?                    @map("invoice_terms_text") @db.Text
  invoiceFooterNote                    String?                    @map("invoice_footer_note") @db.Text
  updatedAt                            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("organization_settings")
}

model InvoiceSequence {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  docType        DocumentSequenceType @map("doc_type")
  financialYear  String               @map("financial_year") @db.VarChar(12)
  prefix         String               @db.VarChar(24)
  currentValue   Int                  @default(0) @map("current_value")
  paddingLength  Int                  @default(5) @map("padding_length")
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, docType, financialYear])
  @@map("invoice_sequences")
}

model TaxCode {
  id             String         @id @default(uuid()) @db.Uuid
  code           String         @unique @db.VarChar(32)
  name           String         @db.VarChar(120)
  hsnSacCode     String         @map("hsn_sac_code") @db.VarChar(20)
  supplyCategory SupplyCategory @map("supply_category")
  cgstRate       Decimal        @default(0) @map("cgst_rate") @db.Decimal(7, 4)
  sgstRate       Decimal        @default(0) @map("sgst_rate") @db.Decimal(7, 4)
  igstRate       Decimal        @default(0) @map("igst_rate") @db.Decimal(7, 4)
  isExempt       Boolean        @default(false) @map("is_exempt")
  effectiveFrom  DateTime       @map("effective_from") @db.Date
  effectiveTo    DateTime?      @map("effective_to") @db.Date
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  tests    Test[]
  packages TestPackage[]

  @@index([supplyCategory, isActive])
  @@map("tax_codes")
}

model PaymentGatewaySetting {
  id                   String          @id @default(uuid()) @db.Uuid
  provider             GatewayProvider @unique
  environment          String          @default("SANDBOX") @db.VarChar(20)
  keyIdEnvRef          String          @default("RAZORPAY_KEY_ID") @map("key_id_env_ref") @db.VarChar(64)
  webhookEnabled       Boolean         @default(false) @map("webhook_enabled")
  dynamicQrEnabled     Boolean         @default(false) @map("dynamic_qr_enabled")
  supportedMethodsJson Json            @map("supported_methods_json")
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("payment_gateway_settings")
}

model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @db.VarChar(128)
  actorId      String   @map("actor_id") @db.Uuid
  route        String   @db.VarChar(160)
  requestHash  String   @map("request_hash") @db.Char(64)
  statusCode   Int      @map("status_code")
  responseJson Json     @map("response_json")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([actorId, route, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// ============================================================================
// 2. IDENTITY, RBAC, SESSIONS, PARTNER SCOPING & AUDIT
// ============================================================================

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique @db.VarChar(160)
  mobile             String?    @db.VarChar(24)
  fullName           String     @map("full_name") @db.VarChar(160)
  passwordHash       String     @map("password_hash") @db.VarChar(255)
  portalType         PortalType @map("portal_type")
  isActive           Boolean    @default(true) @map("is_active")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdById        String?    @map("created_by_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy                 User?                     @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdUsers              User[]                    @relation("UserCreatedBy")
  sessions                  Session[]
  passwordResetTokens       PasswordResetToken[]
  userRoles                 UserRole[]
  partnerMemberships        PartnerUser[]
  auditLogs                 AuditLog[]
  createdPatients           Patient[]                 @relation("PatientCreatedBy")
  updatedPatients           Patient[]                 @relation("PatientUpdatedBy")
  capturedConsents          PatientConsent[]
  createdContracts          PartnerContract[]
  createdPartnerPrices      PartnerTestPrice[]
  createdCommissionRates    PartnerCommissionRate[]
  createdOrders             DiagnosticOrder[]
  completedOrderItems       OrderItem[]               @relation("OrderItemCompletedBy")
  approvedOrderItems        OrderItem[]               @relation("OrderItemApprovedBy")
  orderStatusChanges        OrderStatusHistory[]
  issuedInvoices            Invoice[]
  approvedAdjustments       InvoiceAdjustmentNote[]
  recordedPartnerInvoices   PartnerInvoiceReference[]
  generatedDocuments        InvoiceDocument[]
  createdShareTokens        DocumentShareToken[]
  invoiceShareLogs          InvoiceShareLog[]
  collectedPayments         PatientPayment[]
  createdQrSessions         PaymentQrSession[]
  issuedReceipts            PaymentReceipt[]
  requestedRefunds          Refund[]                  @relation("RefundRequestedBy")
  approvedRefunds           Refund[]                  @relation("RefundApprovedBy")
  reconciledGatewayBatches  GatewaySettlement[]
  reconciledCollections     CollectionRecord[]
  reviewedReportTrackings   ReportTracking[]
  uploadedReportFiles       ReportFile[]
  uploadedAttachments       FileAttachment[]
  documentAccessLogs        DocumentAccessLog[]
  preparedSettlements       Settlement[]              @relation("SettlementPreparedBy")
  approvedSettlements       Settlement[]              @relation("SettlementApprovedBy")
  recordedPartnerPayments   PartnerPayment[]
  createdAllocations        PaymentAllocation[]
  approvedPartnerAdjusts    PartnerAdjustment[]
  postedJournalEntries      JournalEntry[]
  reconciledBankRecords     ReconciliationRecord[]

  @@index([portalType, isActive])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  sessionTokenHash String    @unique @map("session_token_hash") @db.Char(64)
  csrfToken        String    @map("csrf_token") @db.VarChar(64)
  userId           String    @map("user_id") @db.Uuid
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(64)
  name        String    @db.VarChar(120)
  description String?   @db.Text
  scope       RoleScope
  isSystem    Boolean   @default(true) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(80)
  module      String   @db.VarChar(60)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model PartnerUser {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  partnerId   String          @map("partner_id") @db.Uuid
  partnerRole PartnerRoleCode @map("partner_role")
  isPrimary   Boolean         @default(false) @map("is_primary")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@unique([userId, partnerId])
  @@index([partnerId, isActive])
  @@map("partner_users")
}

model AuditLog {
  id                String   @id @default(uuid()) @db.Uuid
  actorUserId       String?  @map("actor_user_id") @db.Uuid
  actorRoleSnapshot String?  @map("actor_role_snapshot") @db.VarChar(160)
  partnerScopeId    String?  @map("partner_scope_id") @db.Uuid
  action            String   @db.VarChar(100)
  entityType        String   @map("entity_type") @db.VarChar(64)
  entityId          String   @map("entity_id") @db.VarChar(80)
  requestId         String?  @map("request_id") @db.VarChar(64)
  ipAddress         String?  @map("ip_address") @db.VarChar(64)
  userAgent         String?  @map("user_agent") @db.VarChar(512)
  beforeJson        Json?    @map("before_json")
  afterJson         Json?    @map("after_json")
  metadataJson      Json?    @map("metadata_json")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([partnerScopeId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ============================================================================
// 3. PATIENTS & CONSENTS
// ============================================================================

model Patient {
  id               String    @id @default(uuid()) @db.Uuid
  patientCode      String    @unique @map("patient_code") @db.VarChar(32)
  fullName         String    @map("full_name") @db.VarChar(160)
  mobile           String    @db.VarChar(24)
  alternateMobile  String?   @map("alternate_mobile") @db.VarChar(24)
  email            String?   @db.VarChar(160)
  dateOfBirth      DateTime? @map("date_of_birth") @db.Date
  ageYearsSnapshot Int?      @map("age_years_snapshot") @db.SmallInt
  gender           Gender
  addressLine      String?   @map("address_line") @db.Text
  city             String?   @db.VarChar(100)
  state            String?   @db.VarChar(100)
  pincode          String?   @db.VarChar(12)
  isActive         Boolean   @default(true) @map("is_active")
  isDemoData       Boolean   @default(false) @map("is_demo_data")
  createdById      String    @map("created_by_id") @db.Uuid
  updatedById      String?   @map("updated_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy User              @relation("PatientCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?             @relation("PatientUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  contacts  PatientContact[]
  consents  PatientConsent[]
  orders    DiagnosticOrder[]
  invoices  Invoice[]
  receipts  PaymentReceipt[]

  @@index([mobile])
  @@index([fullName])
  @@index([createdAt(sort: Desc)])
  @@map("patients")
}

model PatientContact {
  id                String   @id @default(uuid()) @db.Uuid
  patientId         String   @map("patient_id") @db.Uuid
  contactName       String   @map("contact_name") @db.VarChar(160)
  relationship      String   @db.VarChar(60)
  mobile            String   @db.VarChar(24)
  email             String?  @db.VarChar(160)
  isPrimaryGuardian Boolean  @default(false) @map("is_primary_guardian")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@map("patient_contacts")
}

model PatientConsent {
  id           String      @id @default(uuid()) @db.Uuid
  patientId    String      @map("patient_id") @db.Uuid
  consentType  ConsentType @map("consent_type")
  granted      Boolean
  capturedById String      @map("captured_by_id") @db.Uuid
  capturedAt   DateTime    @default(now()) @map("captured_at") @db.Timestamptz(3)
  revokedAt    DateTime?   @map("revoked_at") @db.Timestamptz(3)
  notes        String?     @db.VarChar(255)

  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  capturedBy User    @relation(fields: [capturedById], references: [id], onDelete: Restrict)

  @@index([patientId, consentType])
  @@map("patient_consents")
}

// ============================================================================
// 4. TEST CATALOGUE & PACKAGES
// ============================================================================

model TestCategory {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(32)
  name      String   @db.VarChar(120)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tests Test[]

  @@map("test_categories")
}

model Test {
  id                  String   @id @default(uuid()) @db.Uuid
  code                String   @unique @db.VarChar(40)
  name                String   @db.VarChar(200)
  categoryId          String   @map("category_id") @db.Uuid
  description         String?  @db.Text
  sampleType          String?  @map("sample_type") @db.VarChar(80)
  turnaroundHours     Int?     @map("turnaround_hours")
  defaultSellingPrice Decimal  @map("default_selling_price") @db.Decimal(14, 2)
  taxCodeId           String?  @map("tax_code_id") @db.Uuid
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  category          TestCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  taxCode           TaxCode?                @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  packageItems      TestPackageItem[]
  partnerTestPrices PartnerTestPrice[]
  commissionRates   PartnerCommissionRate[]
  orderItems        OrderItem[]

  @@index([categoryId, isActive])
  @@index([name])
  @@map("tests")
}

model TestPackage {
  id                  String   @id @default(uuid()) @db.Uuid
  code                String   @unique @db.VarChar(40)
  name                String   @db.VarChar(200)
  description         String?  @db.Text
  defaultSellingPrice Decimal  @map("default_selling_price") @db.Decimal(14, 2)
  taxCodeId           String?  @map("tax_code_id") @db.Uuid
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  taxCode              TaxCode?              @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  items                TestPackageItem[]
  partnerPackagePrices PartnerPackagePrice[]
