  docKind        DocumentKind @map("doc_kind")
  storageKey     String       @unique @map("storage_key") @db.VarChar(255)
  sha256Checksum String       @map("sha256_checksum") @db.Char(64)
  fileSizeBytes  Int          @map("file_size_bytes")
  generatedById  String?      @map("generated_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice     Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  receipt     PaymentReceipt? @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  generatedBy User?           @relation(fields: [generatedById], references: [id], onDelete: Restrict)

  @@index([invoiceId, docKind])
  @@map("invoice_documents")
}

model DocumentShareToken {
  id           String            @id @default(uuid()) @db.Uuid
  tokenHash    String            @unique @map("token_hash") @db.Char(64)
  resourceType ShareResourceType @map("resource_type")
  resourceId   String            @map("resource_id") @db.Uuid
  expiresAt    DateTime          @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime?         @map("revoked_at") @db.Timestamptz(3)
  maxViews     Int?              @map("max_views")
  viewCount    Int               @default(0) @map("view_count")
  createdById  String            @map("created_by_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy  User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  shareLogs  InvoiceShareLog[]
  accessLogs DocumentAccessLog[]

  @@index([resourceType, resourceId])
  @@index([expiresAt])
  @@map("document_share_tokens")
}

model InvoiceShareLog {
  id                String         @id @default(uuid()) @db.Uuid
  invoiceId         String?        @map("invoice_id") @db.Uuid
  receiptId         String?        @map("receipt_id") @db.Uuid
  reportFileId      String?        @map("report_file_id") @db.Uuid
  channel           ShareChannel
  destinationMasked String?        @map("destination_masked") @db.VarChar(160)
  shareTokenId      String?        @map("share_token_id") @db.Uuid
  providerMessageId String?        @map("provider_message_id") @db.VarChar(160)
  deliveryStatus    DeliveryStatus @map("delivery_status")
  errorMessage      String?        @map("error_message") @db.Text
  sharedById        String         @map("shared_by_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice    Invoice?            @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  receipt    PaymentReceipt?     @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  reportFile ReportFile?         @relation(fields: [reportFileId], references: [id], onDelete: Restrict)
  shareToken DocumentShareToken? @relation(fields: [shareTokenId], references: [id], onDelete: Restrict)
  sharedBy   User                @relation(fields: [sharedById], references: [id], onDelete: Restrict)

  @@index([invoiceId, createdAt(sort: Desc)])
  @@map("invoice_share_logs")
}

// ============================================================================
// 8. SPLIT PAYMENTS, RAZORPAY, DYNAMIC UPI QR, RECEIPTS & REFUNDS
// ============================================================================

model PatientPayment {
  id                String        @id @default(uuid()) @db.Uuid
  invoiceId         String        @map("invoice_id") @db.Uuid
  amount            Decimal       @db.Decimal(14, 2)
  currency          String        @default("INR") @db.Char(3)
  paymentMethod     PaymentMethod @map("payment_method")
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  paymentDate       DateTime      @default(now()) @map("payment_date") @db.Timestamptz(3)
  collectedById     String?       @map("collected_by_id") @db.Uuid
  externalReference String?       @map("external_reference") @db.VarChar(120)
  idempotencyKey    String?       @map("idempotency_key") @db.VarChar(128)
  notes             String?       @db.Text
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  invoice            Invoice                    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  collectedBy        User?                      @relation(fields: [collectedById], references: [id], onDelete: Restrict)
  gatewayTransaction PaymentGatewayTransaction?
  qrSessions         PaymentQrSession[]
  receipt            PaymentReceipt?
  refunds            Refund[]
  matchedCollections CollectionRecord[]

  @@index([invoiceId, paymentStatus])
  @@index([paymentDate(sort: Desc), paymentMethod])
  @@map("patient_payments")
}

model PaymentGatewayTransaction {
  id                        String                 @id @default(uuid()) @db.Uuid
  paymentId                 String                 @unique @map("payment_id") @db.Uuid
  gateway                   GatewayProvider
  gatewayOrderId            String?                @map("gateway_order_id") @db.VarChar(80)
  gatewayPaymentId          String?                @map("gateway_payment_id") @db.VarChar(80)
  gatewayQrId               String?                @map("gateway_qr_id") @db.VarChar(80)
  gatewaySignatureVerified  Boolean                @default(false) @map("gateway_signature_verified")
  gatewayMethod             String?                @map("gateway_method") @db.VarChar(40)
  gatewayStatus             String                 @map("gateway_status") @db.VarChar(40)
  grossAmount               Decimal                @map("gross_amount") @db.Decimal(14, 2)
  gatewayFee                Decimal                @default(0) @map("gateway_fee") @db.Decimal(14, 2)
  gatewayFeeTax             Decimal                @default(0) @map("gateway_fee_tax") @db.Decimal(14, 2)
  netSettlementEstimate     Decimal?               @map("net_settlement_estimate") @db.Decimal(14, 2)
  settlementStatus          GatewaySettlementState @default(UNSETTLED) @map("settlement_status")
  minimizedPayloadJson      Json?                  @map("minimized_payload_json")
  verifiedAt                DateTime?              @map("verified_at") @db.Timestamptz(3)
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment               PatientPayment                @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  settlementAllocations GatewaySettlementAllocation[]

  @@unique([gateway, gatewayPaymentId])
  @@index([gatewayOrderId])
  @@index([settlementStatus])
  @@map("payment_gateway_transactions")
}

model PaymentQrSession {
  id          String          @id @default(uuid()) @db.Uuid
  paymentId   String          @map("payment_id") @db.Uuid
  invoiceId   String          @map("invoice_id") @db.Uuid
  gatewayQrId String          @unique @map("gateway_qr_id") @db.VarChar(80)
  qrMode      QrMode          @default(DYNAMIC_SINGLE_USE) @map("qr_mode")
  amount      Decimal         @db.Decimal(14, 2)
  qrImageUrl  String?         @map("qr_image_url") @db.Text
  qrPayload   String?         @map("qr_payload") @db.Text
  status      QrSessionStatus @default(ACTIVE)
  expiresAt   DateTime        @map("expires_at") @db.Timestamptz(3)
  closedAt    DateTime?       @map("closed_at") @db.Timestamptz(3)
  createdById String          @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  payment   PatientPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice   Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy User           @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([invoiceId, status])
  @@map("payment_qr_sessions")
}

model PaymentWebhookEvent {
  id                  String                  @id @default(uuid()) @db.Uuid
  gateway             GatewayProvider
  eventId             String                  @map("event_id") @db.VarChar(120)
  eventType           String                  @map("event_type") @db.VarChar(80)
  signatureVerified   Boolean                 @map("signature_verified")
  processingStatus    WebhookProcessingStatus @default(RECEIVED) @map("processing_status")
  redactedPayloadJson Json                    @map("redacted_payload_json")
  errorMessage        String?                 @map("error_message") @db.Text
  receivedAt          DateTime                @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt         DateTime?               @map("processed_at") @db.Timestamptz(3)

  @@unique([gateway, eventId])
  @@index([processingStatus, receivedAt(sort: Desc)])
  @@map("payment_webhook_events")
}

model PaymentReceipt {
  id                    String   @id @default(uuid()) @db.Uuid
  receiptNumber         String   @unique @map("receipt_number") @db.VarChar(40)
  paymentId             String   @unique @map("payment_id") @db.Uuid
  invoiceId             String   @map("invoice_id") @db.Uuid
  patientId             String   @map("patient_id") @db.Uuid
  amount                Decimal  @db.Decimal(14, 2)
  paymentMethodSnapshot String   @map("payment_method_snapshot") @db.VarChar(40)
  invoiceBalanceAfter   Decimal  @map("invoice_balance_after") @db.Decimal(14, 2)
  pdfStorageKey         String?  @map("pdf_storage_key") @db.VarChar(255)
  issuedById            String?  @map("issued_by_id") @db.Uuid
  issuedAt              DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)

  payment   PatientPayment    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice   Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  issuedBy  User?             @relation(fields: [issuedById], references: [id], onDelete: Restrict)
  documents InvoiceDocument[]
  shareLogs InvoiceShareLog[]

  @@index([invoiceId])
  @@map("payment_receipts")
}

model Refund {
  id              String       @id @default(uuid()) @db.Uuid
  refundNumber    String       @unique @map("refund_number") @db.VarChar(40)
  paymentId       String       @map("payment_id") @db.Uuid
  invoiceId       String       @map("invoice_id") @db.Uuid
  refundMethod    RefundMethod @map("refund_method")
  gatewayRefundId String?      @unique @map("gateway_refund_id") @db.VarChar(80)
  amount          Decimal      @db.Decimal(14, 2)
  reason          String       @db.Text
  status          RefundStatus @default(PENDING)
  requestedById   String       @map("requested_by_id") @db.Uuid
  approvedById    String?      @map("approved_by_id") @db.Uuid
  processedAt     DateTime?    @map("processed_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  payment     PatientPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice     Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  requestedBy User           @relation("RefundRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User?          @relation("RefundApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([invoiceId, status])
  @@map("refunds")
}

model GatewaySettlement {
  id                  String    @id @default(uuid()) @db.Uuid
  gateway             GatewayProvider
  gatewaySettlementId String    @unique @map("gateway_settlement_id") @db.VarChar(80)
  utrNumber           String?   @map("utr_number") @db.VarChar(80)
  grossAmount         Decimal   @map("gross_amount") @db.Decimal(14, 2)
  totalFee            Decimal   @default(0) @map("total_fee") @db.Decimal(14, 2)
  totalTax            Decimal   @default(0) @map("total_tax") @db.Decimal(14, 2)
  netAmount           Decimal   @map("net_amount") @db.Decimal(14, 2)
  settledAt           DateTime  @map("settled_at") @db.Timestamptz(3)
  bankReconciledAt    DateTime? @map("bank_reconciled_at") @db.Timestamptz(3)
  reconciledById      String?   @map("reconciled_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  reconciledBy          User?                         @relation(fields: [reconciledById], references: [id], onDelete: Restrict)
  allocations           GatewaySettlementAllocation[]
  reconciliationRecords ReconciliationRecord[]

  @@index([settledAt(sort: Desc)])
  @@map("gateway_settlements")
}

model GatewaySettlementAllocation {
  id                   String  @id @default(uuid()) @db.Uuid
  gatewaySettlementId  String  @map("gateway_settlement_id") @db.Uuid
  gatewayTransactionId String  @map("gateway_transaction_id") @db.Uuid
  allocatedGross       Decimal @map("allocated_gross") @db.Decimal(14, 2)
  allocatedFee         Decimal @default(0) @map("allocated_fee") @db.Decimal(14, 2)
  allocatedTax         Decimal @default(0) @map("allocated_tax") @db.Decimal(14, 2)
  allocatedNet         Decimal @map("allocated_net") @db.Decimal(14, 2)

  gatewaySettlement  GatewaySettlement         @relation(fields: [gatewaySettlementId], references: [id], onDelete: Restrict)
  gatewayTransaction PaymentGatewayTransaction @relation(fields: [gatewayTransactionId], references: [id], onDelete: Restrict)

  @@unique([gatewaySettlementId, gatewayTransactionId])
  @@map("gateway_settlement_allocations")
}

model CollectionRecord {
  id                   String               @id @default(uuid()) @db.Uuid
  recordType           CollectionRecordType @map("record_type")
  orderId              String?              @map("order_id") @db.Uuid
  partnerId            String?              @map("partner_id") @db.Uuid
  matchedInvoiceId     String?              @map("matched_invoice_id") @db.Uuid
  matchedPaymentId     String?              @map("matched_payment_id") @db.Uuid
  amount               Decimal              @db.Decimal(14, 2)
  referenceNumber      String               @map("reference_number") @db.VarChar(120)
  collectedAt          DateTime             @map("collected_at") @db.Timestamptz(3)
  reconciliationStatus ReconciliationStatus @default(UNRECONCILED) @map("reconciliation_status")
  reconciledById       String?              @map("reconciled_by_id") @db.Uuid
  notes                String?              @db.Text
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  order          DiagnosticOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  partner        Partner?         @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  matchedInvoice Invoice?         @relation(fields: [matchedInvoiceId], references: [id], onDelete: Restrict)
  matchedPayment PatientPayment?  @relation(fields: [matchedPaymentId], references: [id], onDelete: Restrict)
  reconciledBy   User?            @relation(fields: [reconciledById], references: [id], onDelete: Restrict)

  @@index([recordType, reconciliationStatus])
  @@map("collection_records")
}

// ============================================================================
// 9. DIAGNOSTIC REPORTS & PRIVATE FILE ATTACHMENTS
// ============================================================================

model ReportTracking {
  id           String               @id @default(uuid()) @db.Uuid
  orderItemId  String               @unique @map("order_item_id") @db.Uuid
  status       ReportTrackingStatus @default(AWAITING)
  expectedAt   DateTime?            @map("expected_at") @db.Timestamptz(3)
  receivedAt   DateTime?            @map("received_at") @db.Timestamptz(3)
  reviewedById String?              @map("reviewed_by_id") @db.Uuid
  deliveredAt  DateTime?            @map("delivered_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  orderItem  OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  reviewedBy User?     @relation(fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([status])
  @@map("report_tracking")
}

model ReportFile {
  id               String     @id @default(uuid()) @db.Uuid
  orderItemId      String     @map("order_item_id") @db.Uuid
  versionNumber    Int        @default(1) @map("version_number")
  originalFilename String     @map("original_filename") @db.VarChar(255)
  mimeType         String     @map("mime_type") @db.VarChar(100)
  fileSizeBytes    Int        @map("file_size_bytes")
  sha256Checksum   String     @map("sha256_checksum") @db.Char(64)
  storageKey       String     @unique @map("storage_key") @db.VarChar(255)
  isLatest         Boolean    @default(true) @map("is_latest")
  uploadedByUserId String     @map("uploaded_by_user_id") @db.Uuid
  uploadedPortal   PortalType @map("uploaded_portal")
  supersededAt     DateTime?  @map("superseded_at") @db.Timestamptz(3)
  notes            String?    @db.Text
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  orderItem  OrderItem         @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  uploadedBy User              @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  shareLogs  InvoiceShareLog[]

  @@index([orderItemId, isLatest])
  @@map("report_files")
}

model FileAttachment {
  id               String   @id @default(uuid()) @db.Uuid
  orderId          String?  @map("order_id") @db.Uuid
  category         String   @db.VarChar(60)
  originalFilename String   @map("original_filename") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(100)
  fileSizeBytes    Int      @map("file_size_bytes")
  sha256Checksum   String   @map("sha256_checksum") @db.Char(64)
  storageKey       String   @unique @map("storage_key") @db.VarChar(255)
  uploadedById     String   @map("uploaded_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order      DiagnosticOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  uploadedBy User             @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@map("file_attachments")
}

model DocumentAccessLog {
  id           String   @id @default(uuid()) @db.Uuid
  resourceType String   @map("resource_type") @db.VarChar(40)
  resourceId   String   @map("resource_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  shareTokenId String?  @map("share_token_id") @db.Uuid
  action       String   @db.VarChar(40)
  ipAddress    String?  @map("ip_address") @db.VarChar(64)
  userAgent    String?  @map("user_agent") @db.VarChar(512)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor      User?               @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  shareToken DocumentShareToken? @relation(fields: [shareTokenId], references: [id], onDelete: Restrict)

  @@index([resourceType, resourceId, createdAt(sort: Desc)])
  @@map("document_access_logs")
}

// ============================================================================
// 10. PARTNER SETTLEMENTS, PAYMENTS, ALLOCATIONS & DOUBLE-ENTRY ACCOUNTING
// ============================================================================

model Settlement {
  id                      String              @id @default(uuid()) @db.Uuid
  settlementNumber        String              @unique @map("settlement_number") @db.VarChar(40)
  partnerId               String              @map("partner_id") @db.Uuid
  direction               SettlementDirection
  commercialModel         CommercialModel     @map("commercial_model")
  periodStart             DateTime            @map("period_start") @db.Date
  periodEnd               DateTime            @map("period_end") @db.Date
  status                  SettlementStatus    @default(DRAFT)
  grossEligibleAmount     Decimal             @map("gross_eligible_amount") @db.Decimal(14, 2)
  adjustmentsAmount       Decimal             @default(0) @map("adjustments_amount") @db.Decimal(14, 2)
  taxAmount               Decimal             @default(0) @map("tax_amount") @db.Decimal(14, 2)
  netAmount               Decimal             @map("net_amount") @db.Decimal(14, 2)
  settledAmount           Decimal             @default(0) @map("settled_amount") @db.Decimal(14, 2)
  balanceAmount           Decimal             @map("balance_amount") @db.Decimal(14, 2)
  preparedById            String              @map("prepared_by_id") @db.Uuid
  approvedById            String?             @map("approved_by_id") @db.Uuid
  approvedAt              DateTime?           @map("approved_at") @db.Timestamptz(3)
  reversalReason          String?             @map("reversal_reason") @db.Text
  reversedAt              DateTime?           @map("reversed_at") @db.Timestamptz(3)
  notes                   String?             @db.Text
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  partner            Partner             @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  preparedBy         User                @relation("SettlementPreparedBy", fields: [preparedById], references: [id], onDelete: Restrict)
  approvedBy         User?               @relation("SettlementApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  items              SettlementItem[]
  paymentAllocations PaymentAllocation[]
  adjustments        PartnerAdjustment[]

  @@index([partnerId, status, periodEnd(sort: Desc)])
  @@map("settlements")
}

model SettlementItem {
  id                     String   @id @default(uuid()) @db.Uuid
  settlementId           String   @map("settlement_id") @db.Uuid
  orderItemId            String   @map("order_item_id") @db.Uuid
  orderId                String   @map("order_id") @db.Uuid
  isActiveLock           Boolean  @default(true) @map("is_active_lock")
  testNameSnapshot       String   @map("test_name_snapshot") @db.VarChar(200)
  completedAtSnapshot    DateTime @map("completed_at_snapshot") @db.Timestamptz(3)
  baseAmount             Decimal  @map("base_amount") @db.Decimal(14, 2)
  commissionRateSnapshot Decimal? @map("commission_rate_snapshot") @db.Decimal(7, 4)
  settlementAmount       Decimal  @map("settlement_amount") @db.Decimal(14, 2)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  settlement Settlement      @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  orderItem  OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  order      DiagnosticOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([settlementId, orderItemId])
  @@index([orderItemId, isActiveLock])
  @@map("settlement_items")
}

model PartnerPayment {
  id                String                  @id @default(uuid()) @db.Uuid
  partnerId         String                  @map("partner_id") @db.Uuid
  direction         PartnerPaymentDirection
  amount            Decimal                 @db.Decimal(14, 2)
  unallocatedAmount Decimal                 @map("unallocated_amount") @db.Decimal(14, 2)
  paymentMethod     PartnerPayoutMethod     @map("payment_method")
  utrOrReference    String                  @map("utr_or_reference") @db.VarChar(120)
  paymentDate       DateTime                @map("payment_date") @db.Timestamptz(3)
  bankAccountId     String?                 @map("bank_account_id") @db.Uuid
  recordedById      String                  @map("recorded_by_id") @db.Uuid
  notes             String?                 @db.Text
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  partner     Partner             @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  bankAccount BankAccount?        @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  recordedBy  User                @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@index([partnerId, paymentDate(sort: Desc)])
  @@map("partner_payments")
}

model PaymentAllocation {
  id               String   @id @default(uuid()) @db.Uuid
  settlementId     String   @map("settlement_id") @db.Uuid
  partnerPaymentId String   @map("partner_payment_id") @db.Uuid
  allocatedAmount  Decimal  @map("allocated_amount") @db.Decimal(14, 2)
  allocatedById    String   @map("allocated_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  settlement     Settlement     @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  partnerPayment PartnerPayment @relation(fields: [partnerPaymentId], references: [id], onDelete: Restrict)
  allocatedBy    User           @relation(fields: [allocatedById], references: [id], onDelete: Restrict)

  @@index([settlementId])
  @@index([partnerPaymentId])
  @@map("payment_allocations")
}

model PartnerAdjustment {
  id             String                @id @default(uuid()) @db.Uuid
  settlementId   String?               @map("settlement_id") @db.Uuid
  partnerId      String                @map("partner_id") @db.Uuid
  adjustmentType PartnerAdjustmentType @map("adjustment_type")
  amount         Decimal               @db.Decimal(14, 2)
  reason         String                @db.Text
  approvedById   String                @map("approved_by_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  settlement Settlement? @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  partner    Partner     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  approvedBy User        @relation(fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([partnerId])
  @@map("partner_adjustments")
}

model ChartOfAccount {
  id          String      @id @default(uuid()) @db.Uuid
  code        String      @unique @db.VarChar(24)
  name        String      @db.VarChar(160)
  accountType AccountType @map("account_type")
  isSystem    Boolean     @default(true) @map("is_system")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  journalLines JournalEntryLine[]
  bankAccounts BankAccount[]

  @@map("chart_of_accounts")
}

model AccountingPeriod {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @db.VarChar(24)
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  isClosed  Boolean   @default(false) @map("is_closed")
  closedAt  DateTime? @map("closed_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  journalEntries JournalEntry[]

  @@map("accounting_periods")
}

model JournalEntry {
  id                String   @id @default(uuid()) @db.Uuid
  entryNumber       String   @unique @map("entry_number") @db.VarChar(40)
  periodId          String?  @map("period_id") @db.Uuid
  postingDate       DateTime @default(now()) @map("posting_date") @db.Timestamptz(3)
  referenceType     String   @map("reference_type") @db.VarChar(60)
  referenceId       String   @map("reference_id") @db.VarChar(80)
  narration         String   @db.Text
  reversalOfEntryId String?  @unique @map("reversal_of_entry_id") @db.Uuid
  postedById        String?  @map("posted_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  period          AccountingPeriod?  @relation(fields: [periodId], references: [id], onDelete: Restrict)
  reversalOfEntry JournalEntry?      @relation("JournalReversal", fields: [reversalOfEntryId], references: [id], onDelete: Restrict)
  reversedByEntry JournalEntry?      @relation("JournalReversal")
  postedBy        User?              @relation(fields: [postedById], references: [id], onDelete: Restrict)
  lines           JournalEntryLine[]

  @@index([referenceType, referenceId])
  @@index([postingDate(sort: Desc)])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String  @id @default(uuid()) @db.Uuid
  journalEntryId String  @map("journal_entry_id") @db.Uuid
  accountId      String  @map("account_id") @db.Uuid
  debitAmount    Decimal @default(0) @map("debit_amount") @db.Decimal(14, 2)
  creditAmount   Decimal @default(0) @map("credit_amount") @db.Decimal(14, 2)
  partnerId      String? @map("partner_id") @db.Uuid
  memo           String? @db.VarChar(255)

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account      ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

model BankAccount {
  id                  String   @id @default(uuid()) @db.Uuid
  displayName         String   @map("display_name") @db.VarChar(120)
  bankName            String   @map("bank_name") @db.VarChar(120)
  accountNumberMasked String   @map("account_number_masked") @db.VarChar(40)
  ifscCode            String   @map("ifsc_code") @db.VarChar(16)
  ledgerAccountId     String   @map("ledger_account_id") @db.Uuid
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ledgerAccount         ChartOfAccount         @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  partnerPayments       PartnerPayment[]
  reconciliationRecords ReconciliationRecord[]

  @@map("bank_accounts")
}

model ReconciliationRecord {
  id                  String               @id @default(uuid()) @db.Uuid
  bankAccountId       String               @map("bank_account_id") @db.Uuid
  gatewaySettlementId String?              @map("gateway_settlement_id") @db.Uuid
  statementDate       DateTime             @map("statement_date") @db.Date
  bankReferenceUtr    String               @map("bank_reference_utr") @db.VarChar(100)
  statementAmount     Decimal              @map("statement_amount") @db.Decimal(14, 2)
  varianceAmount      Decimal              @default(0) @map("variance_amount") @db.Decimal(14, 2)
  status              ReconciliationStatus @default(MATCHED)
  reconciledById      String               @map("reconciled_by_id") @db.Uuid
  notes               String?              @db.Text
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  bankAccount       BankAccount        @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  gatewaySettlement GatewaySettlement? @relation(fields: [gatewaySettlementId], references: [id], onDelete: Restrict)
  reconciledBy      User               @relation(fields: [reconciledById], references: [id], onDelete: Restrict)

  @@index([bankAccountId, statementDate(sort: Desc)])
  @@map("reconciliation_records")
}

// ============================================================================
// 11. NOTIFICATION TEMPLATES & DELIVERY LOGS
// ============================================================================

model NotificationTemplate {
  id                  String       @id @default(uuid()) @db.Uuid
  code                String       @unique @db.VarChar(64)
  channel             ShareChannel
  providerTemplateId  String?      @map("provider_template_id") @db.VarChar(120)
  subjectTemplate     String?      @map("subject_template") @db.VarChar(200)
  bodyTemplate        String       @map("body_template") @db.Text
  isActive            Boolean      @default(true) @map("is_active")
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  logs NotificationLog[]

  @@map("notification_templates")
}

model NotificationLog {
  id                String         @id @default(uuid()) @db.Uuid
  templateId        String?        @map("template_id") @db.Uuid
  channel           ShareChannel
  eventType         String         @map("event_type") @db.VarChar(60)
  recipientMasked   String         @map("recipient_masked") @db.VarChar(160)
  referenceType     String         @map("reference_type") @db.VarChar(60)
  referenceId       String         @map("reference_id") @db.Uuid
  providerMessageId String?        @map("provider_message_id") @db.VarChar(160)
  status            DeliveryStatus @default(QUEUED)
  attemptCount      Int            @default(1) @map("attempt_count")
  errorMessage      String?        @map("error_message") @db.Text
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  template NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([referenceType, referenceId])
  @@index([status, createdAt(sort: Desc)])
  @@map("notification_logs")
}

