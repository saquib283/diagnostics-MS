  @@map("test_packages")
}

model TestPackageItem {
  id               String  @id @default(uuid()) @db.Uuid
  packageId        String  @map("package_id") @db.Uuid
  testId           String  @map("test_id") @db.Uuid
  quantity         Int     @default(1)
  allocationWeight Decimal @default(1.0000) @map("allocation_weight") @db.Decimal(7, 4)

  package TestPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  test    Test        @relation(fields: [testId], references: [id], onDelete: Restrict)

  @@unique([packageId, testId])
  @@map("test_package_items")
}

// ============================================================================
// 5. PARTNERS, CONTRACTS, NEGOTIATED PRICES & COMMISSION RATES
// ============================================================================

model Partner {
  id                       String          @id @default(uuid()) @db.Uuid
  partnerCode              String          @unique @map("partner_code") @db.VarChar(32)
  legalName                String          @map("legal_name") @db.VarChar(200)
  displayName              String          @map("display_name") @db.VarChar(200)
  contactPerson            String          @map("contact_person") @db.VarChar(160)
  email                    String?         @db.VarChar(160)
  phone                    String          @db.VarChar(24)
  addressLine              String          @map("address_line") @db.Text
  city                     String          @db.VarChar(100)
  stateCode                String          @map("state_code") @db.Char(2)
  stateName                String          @map("state_name") @db.VarChar(100)
  pincode                  String          @db.VarChar(12)
  gstin                    String?         @db.VarChar(20)
  pan                      String?         @db.VarChar(16)
  defaultPaymentModel      CommercialModel @map("default_payment_model")
  paymentTermsDays         Int             @default(15) @map("payment_terms_days")
  bankAccountName          String?         @map("bank_account_name") @db.VarChar(160)
  bankAccountNumberMasked  String?         @map("bank_account_number_masked") @db.VarChar(40)
  bankIfsc                 String?         @map("bank_ifsc") @db.VarChar(16)
  status                   PartnerStatus   @default(ACTIVE)
  isDemoData               Boolean         @default(false) @map("is_demo_data")
  notes                    String?         @db.Text
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  partnerUsers             PartnerUser[]
  contracts                PartnerContract[]
  testPrices               PartnerTestPrice[]
  packagePrices            PartnerPackagePrice[]
  commissionRates          PartnerCommissionRate[]
  orders                   DiagnosticOrder[]
  invoices                 Invoice[]
  partnerInvoiceReferences PartnerInvoiceReference[]
  collectionRecords        CollectionRecord[]
  settlements              Settlement[]
  partnerPayments          PartnerPayment[]
  partnerAdjustments       PartnerAdjustment[]

  @@index([status])
  @@map("partners")
}

model PartnerContract {
  id                  String                     @id @default(uuid()) @db.Uuid
  partnerId           String                     @map("partner_id") @db.Uuid
  contractNumber      String                     @unique @map("contract_number") @db.VarChar(48)
  allowedModels       AllowedContractModels      @map("allowed_models")
  commissionBasis     CommissionCalculationBasis @default(UNCONFIGURED) @map("commission_basis")
  settlementCycle     SettlementCycle            @default(MONTHLY) @map("settlement_cycle")
  effectiveFrom       DateTime                   @map("effective_from") @db.Date
  effectiveTo         DateTime?                  @map("effective_to") @db.Date
  agreementStorageKey String?                    @map("agreement_storage_key") @db.VarChar(255)
  status              ContractStatus             @default(ACTIVE)
  notes               String?                    @db.Text
  createdById         String                     @map("created_by_id") @db.Uuid
  createdAt           DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)

  partner   Partner           @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  createdBy User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  orders    DiagnosticOrder[]

  @@index([partnerId, status])
  @@map("partner_contracts")
}

model PartnerTestPrice {
  id                  String    @id @default(uuid()) @db.Uuid
  partnerId           String    @map("partner_id") @db.Uuid
  testId              String    @map("test_id") @db.Uuid
  agreedPurchasePrice Decimal   @map("agreed_purchase_price") @db.Decimal(14, 2)
  partnerMrpReference Decimal?  @map("partner_mrp_reference") @db.Decimal(14, 2)
  isPerformed         Boolean   @default(true) @map("is_performed")
  effectiveFrom       DateTime  @map("effective_from") @db.Date
  effectiveTo         DateTime? @map("effective_to") @db.Date
  isActive            Boolean   @default(true) @map("is_active")
  createdById         String    @map("created_by_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  test      Test    @relation(fields: [testId], references: [id], onDelete: Restrict)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([partnerId, testId, isActive, effectiveFrom])
  @@map("partner_test_prices")
}

model PartnerPackagePrice {
  id                  String    @id @default(uuid()) @db.Uuid
  partnerId           String    @map("partner_id") @db.Uuid
  packageId           String    @map("package_id") @db.Uuid
  agreedPurchasePrice Decimal   @map("agreed_purchase_price") @db.Decimal(14, 2)
  effectiveFrom       DateTime  @map("effective_from") @db.Date
  effectiveTo         DateTime? @map("effective_to") @db.Date
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  partner Partner     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  package TestPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([partnerId, packageId, isActive])
  @@map("partner_package_prices")
}

model PartnerCommissionRate {
  id                   String                     @id @default(uuid()) @db.Uuid
  partnerId            String                     @map("partner_id") @db.Uuid
  testId               String?                    @map("test_id") @db.Uuid
  commissionPercentage Decimal                    @map("commission_percentage") @db.Decimal(7, 4)
  calculationBasis     CommissionCalculationBasis @map("calculation_basis")
  effectiveFrom        DateTime                   @map("effective_from") @db.Date
  effectiveTo          DateTime?                  @map("effective_to") @db.Date
  isActive             Boolean                    @default(true) @map("is_active")
  createdById          String                     @map("created_by_id") @db.Uuid
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)

  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  test      Test?   @relation(fields: [testId], references: [id], onDelete: Restrict)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([partnerId, testId, isActive, effectiveFrom])
  @@map("partner_commission_rates")
}

// ============================================================================
// 6. DIAGNOSTIC ORDERS, ORDER ITEMS & STATUS HISTORY
// ============================================================================

model DiagnosticOrder {
  id                     String          @id @default(uuid()) @db.Uuid
  orderNumber            String          @unique @map("order_number") @db.VarChar(36)
  patientId              String          @map("patient_id") @db.Uuid
  partnerId              String          @map("partner_id") @db.Uuid
  contractId             String?         @map("contract_id") @db.Uuid
  paymentModel           CommercialModel @map("payment_model")
  status                 OrderStatus     @default(PENDING)
  referringDoctor        String?         @map("referring_doctor") @db.VarChar(160)
  clinicalNotes          String?         @map("clinical_notes") @db.Text
  internalNotes          String?         @map("internal_notes") @db.Text
  subtotalSelling        Decimal         @map("subtotal_selling") @db.Decimal(14, 2)
  discountTotal          Decimal         @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal               Decimal         @default(0) @map("tax_total") @db.Decimal(14, 2)
  netSellingTotal        Decimal         @map("net_selling_total") @db.Decimal(14, 2)
  partnerPayableEstimate Decimal         @default(0) @map("partner_payable_estimate") @db.Decimal(14, 2)
  commissionEstimate     Decimal         @default(0) @map("commission_estimate") @db.Decimal(14, 2)
  scheduledAt            DateTime?       @map("scheduled_at") @db.Timestamptz(3)
  cancelledAt            DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason     String?         @map("cancellation_reason") @db.Text
  createdById            String          @map("created_by_id") @db.Uuid
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  patient                 Patient                  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  partner                 Partner                  @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  contract                PartnerContract?         @relation(fields: [contractId], references: [id], onDelete: Restrict)
  createdBy               User                     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items                   OrderItem[]
  statusHistory           OrderStatusHistory[]
  invoice                 Invoice?
  partnerInvoiceReference PartnerInvoiceReference?
  collectionRecords       CollectionRecord[]
  settlementItems         SettlementItem[]
  attachments             FileAttachment[]

  @@index([patientId, createdAt(sort: Desc)])
  @@index([partnerId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("diagnostic_orders")
}

model OrderItem {
  id                           String                      @id @default(uuid()) @db.Uuid
  orderId                      String                      @map("order_id") @db.Uuid
  testId                       String                      @map("test_id") @db.Uuid
  sourcePackageId              String?                     @map("source_package_id") @db.Uuid
  testCodeSnapshot             String                      @map("test_code_snapshot") @db.VarChar(40)
  testNameSnapshot             String                      @map("test_name_snapshot") @db.VarChar(200)
  hsnSacSnapshot               String?                     @map("hsn_sac_snapshot") @db.VarChar(20)
  quantity                     Int                         @default(1)
  unitSellingPriceSnapshot     Decimal                     @map("unit_selling_price_snapshot") @db.Decimal(14, 2)
  discountAmountSnapshot       Decimal                     @default(0) @map("discount_amount_snapshot") @db.Decimal(14, 2)
  taxableAmountSnapshot        Decimal                     @map("taxable_amount_snapshot") @db.Decimal(14, 2)
  taxCodeSnapshot              String?                     @map("tax_code_snapshot") @db.VarChar(32)
  cgstRateSnapshot             Decimal                     @default(0) @map("cgst_rate_snapshot") @db.Decimal(7, 4)
  sgstRateSnapshot             Decimal                     @default(0) @map("sgst_rate_snapshot") @db.Decimal(7, 4)
  igstRateSnapshot             Decimal                     @default(0) @map("igst_rate_snapshot") @db.Decimal(7, 4)
  taxAmountSnapshot            Decimal                     @default(0) @map("tax_amount_snapshot") @db.Decimal(14, 2)
  netSellingAmountSnapshot     Decimal                     @map("net_selling_amount_snapshot") @db.Decimal(14, 2)
  partnerUnitPriceSnapshot     Decimal                     @map("partner_unit_price_snapshot") @db.Decimal(14, 2)
  partnerNetPayableSnapshot    Decimal                     @map("partner_net_payable_snapshot") @db.Decimal(14, 2)
  commissionPercentageSnapshot Decimal?                    @map("commission_percentage_snapshot") @db.Decimal(7, 4)
  commissionBasisSnapshot      CommissionCalculationBasis? @map("commission_basis_snapshot")
  commissionAmountSnapshot     Decimal?                    @map("commission_amount_snapshot") @db.Decimal(14, 2)
  status                       OrderItemStatus             @default(PENDING)
  completedAt                  DateTime?                   @map("completed_at") @db.Timestamptz(3)
  completedByUserId            String?                     @map("completed_by_user_id") @db.Uuid
  completionApprovedAt         DateTime?                   @map("completion_approved_at") @db.Timestamptz(3)
  completionApprovedById       String?                     @map("completion_approved_by_id") @db.Uuid
  settlementLockStatus         SettlementLockStatus        @default(UNSETTLED) @map("settlement_lock_status")
  notes                        String?                     @db.Text
  createdAt                    DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)

  order                DiagnosticOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  test                 Test                 @relation(fields: [testId], references: [id], onDelete: Restrict)
  sourcePackage        TestPackage?         @relation(fields: [sourcePackageId], references: [id], onDelete: Restrict)
  completedBy          User?                @relation("OrderItemCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)
  completionApprovedBy User?                @relation("OrderItemApprovedBy", fields: [completionApprovedById], references: [id], onDelete: Restrict)
  statusHistory        OrderStatusHistory[]
  invoiceItems         InvoiceItem[]
  reportTracking       ReportTracking?
  reportFiles          ReportFile[]
  settlementItems      SettlementItem[]

  @@index([orderId])
  @@index([status, settlementLockStatus])
  @@map("order_items")
}

model OrderStatusHistory {
  id             String     @id @default(uuid()) @db.Uuid
  orderId        String     @map("order_id") @db.Uuid
  orderItemId    String?    @map("order_item_id") @db.Uuid
  previousStatus String     @map("previous_status") @db.VarChar(40)
  newStatus      String     @map("new_status") @db.VarChar(40)
  reason         String?    @db.Text
  actorUserId    String     @map("actor_user_id") @db.Uuid
  actorPortal    PortalType @map("actor_portal")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  order     DiagnosticOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  actor     User            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt(sort: Desc)])
  @@index([orderItemId, createdAt(sort: Desc)])
  @@map("order_status_history")
}

// ============================================================================
// 7. INVOICES, ADJUSTMENTS, PARTNER REFERENCES & DOCUMENT SHARING
// ============================================================================

model Invoice {
  id                       String        @id @default(uuid()) @db.Uuid
  invoiceNumber            String        @unique @map("invoice_number") @db.VarChar(40)
  orderId                  String        @unique @map("order_id") @db.Uuid
  patientId                String        @map("patient_id") @db.Uuid
  partnerId                String        @map("partner_id") @db.Uuid
  status                   InvoiceStatus @default(UNPAID)
  documentTitleSnapshot    String        @default("Invoice") @map("document_title_snapshot") @db.VarChar(80)
  issueDate                DateTime      @default(now()) @map("issue_date") @db.Timestamptz(3)
  dueDate                  DateTime?     @map("due_date") @db.Timestamptz(3)
  issuerLegalNameSnapshot  String        @map("issuer_legal_name_snapshot") @db.VarChar(200)
  issuerGstinSnapshot      String?       @map("issuer_gstin_snapshot") @db.VarChar(20)
  issuerAddressSnapshot    String        @map("issuer_address_snapshot") @db.Text
  patientNameSnapshot      String        @map("patient_name_snapshot") @db.VarChar(160)
  patientCodeSnapshot      String        @map("patient_code_snapshot") @db.VarChar(32)
  patientMobileSnapshot    String        @map("patient_mobile_snapshot") @db.VarChar(24)
  partnerNameSnapshot      String        @map("partner_name_snapshot") @db.VarChar(200)
  placeOfSupplyStateCode   String?       @map("place_of_supply_state_code") @db.Char(2)
  subtotalAmount           Decimal       @map("subtotal_amount") @db.Decimal(14, 2)
  discountAmount           Decimal       @default(0) @map("discount_amount") @db.Decimal(14, 2)
  taxableAmount            Decimal       @map("taxable_amount") @db.Decimal(14, 2)
  cgstAmount               Decimal       @default(0) @map("cgst_amount") @db.Decimal(14, 2)
  sgstAmount               Decimal       @default(0) @map("sgst_amount") @db.Decimal(14, 2)
  igstAmount               Decimal       @default(0) @map("igst_amount") @db.Decimal(14, 2)
  totalTaxAmount           Decimal       @default(0) @map("total_tax_amount") @db.Decimal(14, 2)
  grandTotal               Decimal       @map("grand_total") @db.Decimal(14, 2)
  creditNoteTotal          Decimal       @default(0) @map("credit_note_total") @db.Decimal(14, 2)
  debitNoteTotal           Decimal       @default(0) @map("debit_note_total") @db.Decimal(14, 2)
  effectiveTotal           Decimal       @map("effective_total") @db.Decimal(14, 2)
  amountPaid               Decimal       @default(0) @map("amount_paid") @db.Decimal(14, 2)
  amountRefunded           Decimal       @default(0) @map("amount_refunded") @db.Decimal(14, 2)
  netCollected             Decimal       @default(0) @map("net_collected") @db.Decimal(14, 2)
  balanceDue               Decimal       @map("balance_due") @db.Decimal(14, 2)
  termsSnapshot            String?       @map("terms_snapshot") @db.Text
  issuedById               String        @map("issued_by_id") @db.Uuid
  voidedAt                 DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidReason               String?       @map("void_reason") @db.Text
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order              DiagnosticOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  patient            Patient                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  partner            Partner                 @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  issuedBy           User                    @relation(fields: [issuedById], references: [id], onDelete: Restrict)
  items              InvoiceItem[]
  taxSnapshots       InvoiceTaxSnapshot[]
  adjustmentNotes    InvoiceAdjustmentNote[]
  documents          InvoiceDocument[]
  shareLogs          InvoiceShareLog[]
  payments           PatientPayment[]
  qrSessions         PaymentQrSession[]
  receipts           PaymentReceipt[]
  refunds            Refund[]
  matchedCollections CollectionRecord[]

  @@index([patientId, issueDate(sort: Desc)])
  @@index([partnerId, status])
  @@index([status, issueDate(sort: Desc)])
  @@map("invoices")
}

model InvoiceItem {
