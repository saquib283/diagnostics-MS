# ==============================================================================
# DCMS — Environment Configuration Template (Placeholders Only — NO Real Secrets)
# Copy this file to `.env` and populate values before starting the application.
# ==============================================================================

NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Kolkata"

# --- PostgreSQL Database (Required) ---
DATABASE_URL="postgresql://postgres:CHANGE_ME_PASSWORD@127.0.0.1:5432/dcms?schema=public"

# --- Server-Side Session & Token Cryptography (Required: min 32 random chars) ---
SESSION_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32_MIN_LENGTH"
SESSION_COOKIE_NAME="dcms_session"
SESSION_IDLE_TIMEOUT_HOURS="12"
SESSION_ABSOLUTE_TIMEOUT_DAYS="7"

# --- Private Object Storage (S3 / Cloudflare R2 / MinIO) ---
# Set STORAGE_DRIVER="s3" in production; "local_private" is allowed ONLY in development/test.
STORAGE_DRIVER="local_private"
LOCAL_PRIVATE_STORAGE_DIR=".private-storage"
S3_REGION="ap-south-1"
S3_ENDPOINT=""
S3_BUCKET_NAME="dcms-private-documents"
S3_ACCESS_KEY_ID="CHANGE_ME_S3_ACCESS_KEY"
S3_SECRET_ACCESS_KEY="CHANGE_ME_S3_SECRET_KEY"
S3_FORCE_PATH_STYLE="false"
S3_PRESIGNED_URL_TTL_SECONDS="300"
MAX_REPORT_UPLOAD_MB="20"

# --- Razorpay Integration (Backend Only — Never prefix secrets with NEXT_PUBLIC_) ---
RAZORPAY_ENABLED="false"
RAZORPAY_KEY_ID="rzp_test_CHANGE_ME"
RAZORPAY_KEY_SECRET="CHANGE_ME_RAZORPAY_KEY_SECRET"
RAZORPAY_WEBHOOK_SECRET="CHANGE_ME_RAZORPAY_WEBHOOK_SECRET"
RAZORPAY_DYNAMIC_QR_ENABLED="false"
RAZORPAY_QR_TTL_SECONDS="600"

# --- WhatsApp Business Platform Provider Adapter ---
# Supported values: "disabled" | "meta_cloud"
WHATSAPP_PROVIDER="disabled"
WHATSAPP_PHONE_NUMBER_ID="CHANGE_ME_PHONE_NUMBER_ID"
WHATSAPP_ACCESS_TOKEN="CHANGE_ME_WHATSAPP_ACCESS_TOKEN"
WHATSAPP_API_BASE_URL="https://graph.facebook.com/v21.0"

# --- Transactional Email Provider Adapter (SMTP) ---
# Supported values: "disabled" | "smtp"
EMAIL_PROVIDER="disabled"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="CHANGE_ME_SMTP_USER"
SMTP_PASSWORD="CHANGE_ME_SMTP_PASSWORD"
EMAIL_FROM_ADDRESS="billing@example-diagnostics.in"
EMAIL_FROM_NAME="Diagnostic Consultancy Billing"

# --- Optional Malware Scanning (ClamAV TCP Daemon) ---
CLAMAV_ENABLED="false"
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"

